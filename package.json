{
  "name": "townsite",
  "version": "0.1.0",
  "private": true,
  "description": "Townsite: a single system of record for real property development approvals (demo).",
  "license": "UNLICENSED",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "verify:design": "node scripts/verify-design.js",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:import": "playwright test tests/import.spec.js",
    "test": "npm run verify:design && npm run test:visual",
    "design:approve": "node scripts/verify-design.js --write && playwright test tests/visual.spec.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
